# ==============================================
# 台股智選系統 - 環境變數範本
# Taiwan Stock Selection System - Environment Variables
# ==============================================
# 
# 使用說明：
# 1. 複製此檔案並重新命名為 .env
#    cp .env.example .env
# 2. 填入您的 API 金鑰
# 3. 驗證設定：python src/env_validator.py
#
# ==============================================

# ----------------------------------------------
# FinMind API Token (必要)
# 用於取得台股財務資料
# 
# 取得方式：
# 1. 前往 https://finmindtrade.com/
# 2. 註冊帳號後在「我的帳號」頁面取得 Token
# 3. 免費方案限制：600 次/分鐘
# ----------------------------------------------
FINMIND_TOKEN=your_token_here

# ----------------------------------------------
# OpenAI API Key (可選)
# 用於 AI 智慧選股的進階語意解析
# 
# 取得方式：
# 1. 前往 https://platform.openai.com/
# 2. 在 API Keys 頁面建立新金鑰
#
# 注意：不設定此項目時，系統會使用內建規則式解析
# ----------------------------------------------
OPENAI_API_KEY=your_openai_key_here
